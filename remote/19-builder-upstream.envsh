#!/bin/sh
# nginx otherwise round-robins IPv4 and IPv6 host-gateway records, even when the
# host listener is IPv4-only. Resolve once using the container's hosts/DNS setup.
builder_upstream_host=${BUILDER_UPSTREAM%:*}
builder_upstream_port=${BUILDER_UPSTREAM##*:}
case "$builder_upstream_host" in
    ''|*[!a-zA-Z0-9.-]*) echo 'BUILDER_UPSTREAM must be an IPv4 address or hostname followed by :port' >&2; exit 1 ;;
esac
case "$builder_upstream_port" in
    ''|*[!0-9]*) echo 'BUILDER_UPSTREAM requires a numeric port' >&2; exit 1 ;;
esac
if [ "${#builder_upstream_port}" -gt 5 ] || [ "$builder_upstream_port" -lt 1 ] || [ "$builder_upstream_port" -gt 65535 ]; then
    echo 'BUILDER_UPSTREAM port must be 1-65535' >&2
    exit 1
fi
builder_upstream_address=$(timeout 5 getent ahostsv4 "$builder_upstream_host" | awk 'NR==1 { print $1 }')
if [ -z "$builder_upstream_address" ]; then
    echo 'Could not resolve BUILDER_UPSTREAM to IPv4; check the container host mapping' >&2
    exit 1
fi
export BUILDER_UPSTREAM="$builder_upstream_address:$builder_upstream_port"

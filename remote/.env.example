# Copy to remote/.env and point your HTTPS reverse proxy or authenticated tunnel
# at the gateway. The same service can be merged into an existing Compose stack.

# Exact public URL, with no path or trailing slash.
BUILDER_GATEWAY_ORIGIN=https://builder.example.com

# Header containing the authenticated browser identity. Match the header set by
# your proxy. Use "none" only for loopback-only local testing.
BUILDER_GATEWAY_AUTH_HEADER=Remote-User

# Optional local port mapping. A proxy sharing the Compose network can instead
# reach builder-gateway:8080 directly.
#BUILDER_GATEWAY_BIND=127.0.0.1
#BUILDER_GATEWAY_PORT=8080

# For an existing external proxy network, also include proxy-network.yaml.
#BUILDER_PROXY_NETWORK=your-proxy-network

# Default proxy-agnostic stack:
COMPOSE_FILE=compose.yaml

# Optional Pangolin/Newt labels:
# BUILDER_DOMAIN=builder.example.com
# COMPOSE_FILE=compose.yaml:pangolin-labels.yaml
# Other examples:
# COMPOSE_FILE=compose.yaml:proxy-network.yaml
# Source checkout only: COMPOSE_FILE=compose.yaml:compose.build.yaml

# Copy to remote/.env (gitignored). Every value is optional; defaults are shown.
# Compose reads this file automatically when the first -f file is remote/compose.yaml.

# host:port of `builder remote --listen ...` as seen from inside the container.
# host.docker.internal resolves to the host's docker0 address (host-gateway).
# On Linux you can also use that address directly, e.g. 172.17.0.1:7432.
#BUILDER_UPSTREAM=host.docker.internal:7432

# Where the container's port 8080 is published on the host. Only a proxy
# running on the host itself needs this; a proxy container uses the network below.
#BUILDER_WEB_BIND=127.0.0.1
#BUILDER_WEB_PORT=8080

# Existing Docker network of your reverse proxy / tunnel container (Pangolin
# newt, Traefik, Caddy). Used only by proxy-network.yaml:
#   docker compose -f remote/compose.yaml -f remote/proxy-network.yaml up -d --build
# Then point the proxy at http://builder-web:8080.
#BUILDER_PROXY_NETWORK=your-proxy-network

# Include the proxy-network override automatically so plain `docker compose up -d`
# (run from the remote/ directory) attaches to BUILDER_PROXY_NETWORK.
#COMPOSE_FILE=compose.yaml:proxy-network.yaml

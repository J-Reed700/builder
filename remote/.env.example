# Copy to remote/.env. For Pangolin, set the two values below and start Compose
# with the image-only compose.yaml plus pangolin-labels.yaml. The same files can
# be merged into an existing Compose project.

# Exact public URL, with no path or trailing slash.
BUILDER_GATEWAY_ORIGIN=https://builder.example.com

# Public hostname used by Pangolin's declarative resource label.
BUILDER_DOMAIN=builder.example.com

# Pangolin forwards this header after SSO. Use "none" only for local testing
# on a loopback-bound port with no public proxy.
#BUILDER_GATEWAY_AUTH_HEADER=Remote-User

# Optional local port mapping. Newt reaches builder-gateway:8080 directly when
# it shares this Compose network, so the published port does not need exposure.
#BUILDER_GATEWAY_BIND=127.0.0.1
#BUILDER_GATEWAY_PORT=8080

# For an existing external Newt/proxy network, also include proxy-network.yaml.
#BUILDER_PROXY_NETWORK=your-proxy-network

# Default standalone stack:
COMPOSE_FILE=compose.yaml:pangolin-labels.yaml

# Other examples:
# COMPOSE_FILE=compose.yaml:proxy-network.yaml:pangolin-labels.yaml
# Source checkout only: COMPOSE_FILE=compose.yaml:compose.build.yaml:pangolin-labels.yaml

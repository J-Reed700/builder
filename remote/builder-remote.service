# systemd user unit for the Builder remote-control host process.
# Installed by remote/install-host-service.sh, which replaces @BUILDER_BIN@ with
# the absolute path of the builder binary and creates ~/.config/builder/remote.env.
[Unit]
Description=Builder remote control host (workspace + model endpoint + SQLite)
Documentation=https://github.com/J-Reed700/builder/blob/main/docs/REMOTE_CONTROL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# BUILDER_REMOTE_WORKSPACE, BUILDER_REMOTE_GATEWAY,
# optional BUILDER_REMOTE_ARGS / BUILDER_HOME / BUILDER_BASIC_AUTH.
EnvironmentFile=@ENV_FILE@
ExecStart=@BUILDER_BIN@ -C ${BUILDER_REMOTE_WORKSPACE} remote connect ${BUILDER_REMOTE_GATEWAY} $BUILDER_REMOTE_ARGS
# Builder shuts down cleanly on SIGINT (same as Ctrl+C in a terminal).
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target

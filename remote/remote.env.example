# Host-side settings for the builder-remote systemd user service.
# Installed to ~/.config/builder/remote.env (keep it 0600: it may hold credentials).

# Workspace the browser can inspect and edit. Anyone with the host token can
# direct Builder's tools inside this directory, so pick a project, not "/".
BUILDER_REMOTE_WORKSPACE=/path/to/your/project

# Address the Docker web container connects to. Must be reachable from Docker
# but should not be public. On Linux the docker0 gateway (usually 172.17.0.1)
# is reachable from every Compose network; on Docker Desktop use 0.0.0.0:7432
# and keep the port firewalled. Match remote/.env BUILDER_UPSTREAM.
BUILDER_REMOTE_LISTEN=172.17.0.1:7432

# Exact public browser origin served by Pangolin / your reverse proxy.
# Scheme + host, no path, no trailing slash.
BUILDER_REMOTE_ORIGIN=https://builder.example.com

# Extra `builder remote` flags, e.g. "--approval read-only" or "--profile local".
#BUILDER_REMOTE_ARGS=

# Alternate config/data directory (same as --home).
#BUILDER_HOME=

# Only if a model profile uses Authorization = { env = "BUILDER_BASIC_AUTH" }.
#BUILDER_BASIC_AUTH=Basic BASE64
